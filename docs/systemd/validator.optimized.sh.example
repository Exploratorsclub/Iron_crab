#!/usr/bin/env bash
set -euo pipefail

# Optimized RPC-only validator launch (mitigates OOM, reduces churn)
# Copy to /usr/local/bin/validator.sh and adjust paths, then point systemd ExecStart to it.

# --- Paths (adjust) ---
IDENTITY=/home/sol/validator-keypair.json
LEDGER_DIR=/mnt/ledger
ACCOUNTS_DIR=/mnt/accounts
ACCOUNTS_INDEX_DIR=/mnt/accounts-index   # fast SSD/NVMe
LOG_FILE=/home/sol/solana-rpc.log

# --- Networking ---
RPC_BIND=127.0.0.1           # local-only; expose via reverse proxy if needed
RPC_PORT=8899
WS_PORT=8900
GOSSIP_PORT=8001
DYN_PORT_RANGE=8000-8020
DISABLE_QUIC=true            # reduce TPU churn for RPC-only

# --- Memory / Index ---
ACCOUNTS_INDEX_MEM_MB=32768  # 32G; increase to 64G if stable
ACCOUNTS_DB_CACHE_MB=32768   # 32G; keep balanced with index
LEDGER_LIMIT=50000000

# --- DEX Programs to index (Raydium v4, Orca Whirlpool); DO NOT index OpenBook for now ---
RAYDIUM_AMM_V4=675kPX9MHTjS2zt1qfr1NYHuzeLXfQM9H24wFSUt1Mp8
ORCA_WHIRL=whirLbMiicV3QDeqAD9nukHf8stYwh5GozfX6rS3SAm
# OPENBOOK_V3=9xQeWvG816bUx9EPjHmaT23yvVM2ZWbrrpZb9PusVFin  # disabled intentionally

BIN=${BIN:-/home/sol/src/agave/target/release/agave-validator}

exec "$BIN" \
  --identity "$IDENTITY" \
  --ledger "$LEDGER_DIR" \
  --accounts "$ACCOUNTS_DIR" \
  --accounts-index-path "$ACCOUNTS_INDEX_DIR" \
  --accounts-index-memory-limit-mb "$ACCOUNTS_INDEX_MEM_MB" \
  --accounts-db-cache-limit-mb "$ACCOUNTS_DB_CACHE_MB" \
  --limit-ledger-size "$LEDGER_LIMIT" \
  --rpc-port "$RPC_PORT" \
  --rpc-bind-address "$RPC_BIND" \
  --pubsub-port "$WS_PORT" \
  --gossip-port "$GOSSIP_PORT" \
  --dynamic-port-range "$DYN_PORT_RANGE" \
  --full-rpc-api \
  --no-voting \
  --private-rpc \
  --account-index program-id \
  --account-index-include-key "$RAYDIUM_AMM_V4" \
  --account-index-include-key "$ORCA_WHIRL" \
  $( $DISABLE_QUIC && echo --tpu-disable-quic ) \
  --no-os-network-limits \
  --entrypoint entrypoint.mainnet-beta.anza.xyz:8001 \
  --entrypoint entrypoint2.mainnet-beta.anza.xyz:8001 \
  --entrypoint entrypoint3.mainnet-beta.anza.xyz:8001 \
  --entrypoint entrypoint4.mainnet-beta.anza.xyz:8001 \
  --log "$LOG_FILE"

# Notes:
# - Remove the OpenBook index to avoid huge memory footprint.
# - Place ACCOUNTS_INDEX_DIR on fast SSD/NVMe; ensure directory exists and owned by 'sol'.
# - If stable, you can raise ACCOUNTS_INDEX_MEM_MB to 65536.
# - Keep RPC bind local and front with a proxy if you need external access.
# - QUIC disable reduces TPU worker channel saturation for RPC-only setups.
