#!/usr/bin/env bash
set -euo pipefail

# Optimized RPC-only validator launch (mitigates OOM, reduces churn)
# Copy to /usr/local/bin/validator.sh and adjust paths, then point systemd ExecStart to it.

# --- Paths (adjust) ---
IDENTITY=/home/sol/validator-keypair.json
LEDGER_DIR=/mnt/ledger
ACCOUNTS_DIR=/mnt/accounts
ACCOUNTS_INDEX_DIR=/mnt/accounts-index   # fast SSD/NVMe
LOG_FILE=/home/sol/solana-rpc.log

# --- Networking ---
RPC_BIND=127.0.0.1           # local-only; expose via reverse proxy if needed
RPC_PORT=8899
# NOTE: Agave/modern solana-validator serves WebSocket on the same RPC port;
# no separate --pubsub-port flag is supported. WS_PORT kept for reference only.
WS_PORT=8900
GOSSIP_PORT=8001
DYN_PORT_RANGE=8000-8020
DISABLE_QUIC=true            # reduce TPU churn for RPC-only

# --- Memory / Index ---
# Hinweis: Agave 2.3.11 unterstützt KEIN --accounts-index-memory-limit-mb.
# Konservativ für ersten stabilen Catch-up starten, dann schrittweise erhöhen.
ACCOUNTS_INDEX_MEM_MB=32768  # nur wirksam, wenn Flag vorhanden (nicht in 2.3.11)
ACCOUNTS_DB_CACHE_MB=16384   # 16G konservativ; nach Catch-up auf 32G erhöhen
LEDGER_LIMIT=50000000

# --- DEX Programs to index (Raydium v4, Orca Whirlpool); DO NOT index OpenBook for now ---
RAYDIUM_AMM_V4=675kPX9MHTjS2zt1qfr1NYHuzeLXfQM9H24wFSUt1Mp8
ORCA_WHIRL=whirLbMiicV3QDeqAD9nukHf8stYwh5GozfX6rS3SAm
# OPENBOOK_V3=9xQeWvG816bUx9EPjHmaT23yvVM2ZWbrrpZb9PusVFin  # disabled intentionally

BIN=${BIN:-/home/sol/src/agave/target/release/agave-validator}

have_flag() {
  "$BIN" --help 2>/dev/null | grep -q -- "$1"
}

# Build args in an array to avoid fragile line-continuations with comments
ARGS=(
  --identity "$IDENTITY"
  --ledger "$LEDGER_DIR"
  --accounts "$ACCOUNTS_DIR"
  --accounts-index-path "$ACCOUNTS_INDEX_DIR"
  --accounts-db-cache-limit-mb "$ACCOUNTS_DB_CACHE_MB"
  --limit-ledger-size "$LEDGER_LIMIT"
  --rpc-port "$RPC_PORT"
  --rpc-bind-address "$RPC_BIND"
  --gossip-port "$GOSSIP_PORT"
  --dynamic-port-range "$DYN_PORT_RANGE"
  --no-voting
  --private-rpc
)

# Nur setzen, wenn Flag vorhanden ist (neuere Agave-Versionen; nicht in 2.3.11)
if have_flag "--accounts-index-memory-limit-mb"; then
  ARGS+=(--accounts-index-memory-limit-mb "$ACCOUNTS_INDEX_MEM_MB")
fi

# --full-rpc-api: Aktiviere NACH stabilem Catch-up (reduziert Last beim Replay)
# ARGS+=(--full-rpc-api)

# Optional: program-id index (RAM-intensiv). Enable AFTER stable catch-up.
# ARGS+=(--account-index program-id)
# ARGS+=(--account-index-include-key "$RAYDIUM_AMM_V4")
# ARGS+=(--account-index-include-key "$ORCA_WHIRL")

# TPU QUIC often unnecessary for RPC-only
if [ "${DISABLE_QUIC}" = true ]; then
  ARGS+=(--tpu-disable-quic)
fi

# Primary Frankfurt-low RTT anycast entrypoints (14-15ms observed)
ARGS+=(--entrypoint entrypoint.mainnet-beta.anza.xyz:8001)
ARGS+=(--entrypoint entrypoint3.mainnet-beta.anza.xyz:8001)
ARGS+=(--entrypoint entrypoint4.mainnet-beta.anza.xyz:8001)
# Backup anycast (kept for redundancy; slightly higher latency acceptable)
ARGS+=(--entrypoint entrypoint2.mainnet-beta.anza.xyz:8001)

# (Optional) Add discovered low-latency EU peers below after running 'solana-gossip spy'
# ARGS+=(--entrypoint <eu-peer-host>:8001)

ARGS+=(--log "$LOG_FILE")

exec "$BIN" "${ARGS[@]}"

# Notes:
# - Place ACCOUNTS_INDEX_DIR on fast SSD/NVMe; ensure directory exists and owned by 'sol'.
# - Start with ACCOUNTS_DB_CACHE_MB=16384; after stable catch-up raise to 32768.
# - Agave 2.3.11 lacks --accounts-index-memory-limit-mb (script guards it).
# - Enable --full-rpc-api and program-id indexes AFTER catch-up completes.
# - Keep RPC bind local (127.0.0.1) and front with a reverse proxy for external access.
# - QUIC disable reduces TPU worker channel saturation for RPC-only setups.
# - To prune high-latency entrypoints: use entrypoint_latency_test_v2.sh (<70ms ideal).
# - After adding custom peers: restart validator; confirm peer count >40 for faster propagation.
