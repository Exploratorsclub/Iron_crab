[Unit]
Description=IronCrab Control Plane (FastAPI)
After=network-online.target nats.service
Wants=network-online.target
PartOf=ironcrab.target

[Service]
Type=simple
User=ironcrab
Group=ironcrab
WorkingDirectory=/home/ironcrab/Iron_crab/control_plane

ExecStart=/home/ironcrab/Iron_crab/.venv/bin/uvicorn main:app \
    --host 127.0.0.1 \
    --port 8080

Environment=NATS_URL=nats://localhost:4222
Environment=MARKET_DATA_URL=http://127.0.0.1:9801
Environment=MOMENTUM_BOT_URL=http://127.0.0.1:9802
Environment=ARB_STRATEGY_URL=http://127.0.0.1:9803
Environment=EXECUTION_ENGINE_URL=http://127.0.0.1:9804

Restart=on-failure
RestartSec=3

# Resource controls: control plane is not time-critical
Nice=15
CPUWeight=50

# Hardening
# NOTE: If you want to use the UI to start/stop/restart services via systemd,
# the control-plane may need permission to call `systemctl` (commonly via sudoers).
# `NoNewPrivileges=yes` prevents sudo from elevating.
NoNewPrivileges=no
PrivateTmp=yes

[Install]
WantedBy=ironcrab.target
