[Unit]
Description=IronCrab Market Data Service (Geyser Ingest)
After=network-online.target nats.service
Wants=network-online.target
PartOf=ironcrab.target
# P1 Crash Isolation: NO hard dependencies - market-data runs independently
# If Geyser is down, it reconnects. Crash here does NOT affect execution-engine.

# Restart rate limiting (prevents crash loops from pegging CPU)
StartLimitBurst=10
StartLimitIntervalSec=300

[Service]
Type=notify
NotifyAccess=main
User=ironcrab
Group=ironcrab
WorkingDirectory=/home/ironcrab/Iron_crab

ExecStart=/home/ironcrab/Iron_crab/target/release/market-data \
    --config /home/ironcrab/Iron_crab/my_config.server.toml \
    --nats-url nats://localhost:4222 \
    --geyser-url http://127.0.0.1:10000 \
    --metrics-port 9801

Environment=RUST_LOG=info,market_data=info,ironcrab::solana::geyser_listener=warn

# P1 Crash Isolation: Watchdog for liveness detection
WatchdogSec=30
# Restart always: transient Geyser stream drops must not leave the unit inactive (exit 0).
Restart=always
RestartSec=3

# Resource controls: lower priority than validator
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
CPUWeight=100
CPUAffinity=48-55

# Hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ironcrab/Iron_crab/trade_logs

[Install]
WantedBy=ironcrab.target
