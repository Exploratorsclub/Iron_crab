# systemd unit for Agave (Solana) Validator RPC
# Place as: /etc/systemd/system/sol.service
# Then: sudo systemctl daemon-reload && sudo systemctl enable sol && sudo systemctl start sol

[Unit]
Description=Agave (Solana) Validator RPC
Wants=network-online.target
After=network-online.target

[Service]
User=sol
WorkingDirectory=/home/sol
Environment=RUST_BACKTRACE=1
Environment=PATH=/home/sol/src/agave/target/release:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=MALLOC_CONF=background_thread:true,dirty_decay_ms:500,muzzy_decay_ms:500
ExecStart=/bin/bash -lc '/home/sol/bin/validator.sh'

# Memory guardrails (start conservative for Agave 2.3.11)
MemoryMax=480G
MemoryHigh=400G
MemorySwapMax=0

# Restart strategy
Restart=always
RestartSec=30s
StartLimitBurst=5
TimeoutStopSec=180

# File descriptor and task limits
LimitNOFILE=1000000
TasksMax=infinity

# Security
NoNewPrivileges=yes

# Scheduling priorities
Nice=-5
IOSchedulingClass=best-effort
IOSchedulingPriority=0

# Cgroups v2 weights
CPUWeight=1000
IOWeight=1000

# OOM handling
OOMPolicy=continue
OOMScoreAdjust=-500

# Notes:
# - MemorySwapMax=0 prevents swap thrashing
# - MemoryHigh=400G provides buffer below 480G max
# - OOMScoreAdjust=-500 protects validator from OOM killer
# - DO NOT set CPUAffinity unless you have NUMA topology plan
# - TimeoutStopSec=180 allows graceful shutdown
# - Adjust paths in validator.sh to match your setup

[Install]
WantedBy=multi-user.target
