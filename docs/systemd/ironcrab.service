[Unit]
Description=IronCrab Trading Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Passe den Benutzer und die Pfade an deine Umgebung an
User=ironcrab
Group=ironcrab
WorkingDirectory=/home/ironcrab/Iron_crab
ExecStart=/home/ironcrab/Iron_crab/run.sh --release --config /home/ironcrab/Iron_crab/my_config.server.toml
# Log level: info für alles, debug nur für sniper (wo die wichtigen Sachen passieren)
# Orca/Raydium auf info (kein TRACE spam), geyser_listener auf warn (noch weniger spam)
Environment=RUST_LOG=info,ironcrab::solana::sniper=info,ironcrab::solana::geyser_listener=warn,ironcrab::solana::dex::orca=info,ironcrab::solana::dex::raydium=info
Restart=on-failure
RestartSec=5

# Resource controls: lower priority and limit CPU/IO share vs validator
# 64 cores: pin bot to CPUs 48-63 (upper quarter)
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
CPUWeight=100
IOWeight=100
CPUAffinity=48-63

# Basis-Hardening (optional, vorsichtig erweitern)
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
