[Unit]
Description=IronCrab Execution Engine (Single Signer)
After=network-online.target nats.service
Wants=network-online.target
PartOf=ironcrab.target
# P1 Crash Isolation: NO hard dependencies - execution-engine runs independently
# If NATS is down, it reconnects. If other services crash, execution continues.

# Restart rate limiting (prevents crash loops from pegging CPU)
StartLimitBurst=5
StartLimitIntervalSec=300

[Service]
# Bootstrap can take 2-3 minutes with 600k+ pool states in POOL_CACHE stream
TimeoutStartSec=300
Type=notify
NotifyAccess=main
User=ironcrab
Group=ironcrab
WorkingDirectory=/home/ironcrab/Iron_crab

ExecStart=/home/ironcrab/Iron_crab/target/release/execution-engine \
    --config /home/ironcrab/Iron_crab/my_config.server.toml \
    --nats-url nats://localhost:4222 \
    --metrics-port 9804

Environment=RUST_LOG=info,execution_engine=info,ironcrab::engine=debug
Environment=IRONCRAB_KEYPAIR_PATH=/home/ironcrab/.config/solana/id.json

# P1 Crash Isolation: Watchdog for liveness detection
WatchdogSec=30
# Restart on failure
Restart=on-failure
RestartSec=5

# Resource controls: execution engine gets higher priority
Nice=5
IOSchedulingClass=best-effort
IOSchedulingPriority=4
CPUWeight=200
CPUAffinity=60-63

# Hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ironcrab/Iron_crab/trade_logs
# File ACL on keypair should restrict read to ironcrab user only

[Install]
WantedBy=ironcrab.target
