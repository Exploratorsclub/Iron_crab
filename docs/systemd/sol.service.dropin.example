# systemd drop-in for sol.service to mitigate OOM and stabilize Agave/Solana RPC
# Place this file as: /etc/systemd/system/sol.service.d/override.conf
# Then run: sudo systemctl daemon-reload && sudo systemctl restart sol
# Adjust memory limits and paths to match your hardware.

[Service]
# jemalloc tuning: background thread reduces fragmentation, decay trims memory faster under pressure
Environment="MALLOC_CONF=background_thread:true,dirty_decay_ms:500,muzzy_decay_ms:500"

# Memory guardrails (tune to your RAM; start conservative and raise gradually)
# Example for a 512G machine; adjust High ~10–20% below Max to avoid swap thrash.
MemoryMax=256G
MemoryHigh=220G
# To avoid swap thrash entirely for this unit, disable swap accounting for it:
#MemorySwapMax=0

# Restart strategy
Restart=always
RestartSec=15s
StartLimitBurst=5

# File descriptor limit (large for many connections)
LimitNOFILE=1000000

# CPU / IO priorities (validator vs bot separation)
Nice=0
IOSchedulingClass=best-effort
IOSchedulingPriority=4
# NUMA note: On multi-socket systems, pinning all threads to a single socket can
# increase remote memory access and memory pressure. Prefer not pinning, or pin
# per-NUMA domain with numactl. Only set CPUAffinity if you know your topology.
#CPUAffinity=0-47

# Environment directory (optional)
#EnvironmentFile=-/etc/solana/validator.env

# Example additional ExecStart flags (EDIT your main unit instead if needed):
# These lines show safe options reducing memory usage; DO NOT duplicate ExecStart here unless overriding.
# --no-voting if you only need an RPC node (not producing blocks)
# --full-rpc-api for complete RPC features, or omit for lighter footprint
# --pubsub-port <PORT> (deprecated/removed in Agave; WebSocket shares --rpc-port)
# --accounts-index-path /mnt/fastssd/accounts-index
# --accounts-index-memory-limit-mb 65536
# --limit-ledger-size 50000000
# --tpu-disable-quic (if QUIC not required / causing churn)
# --rocksdb-shred-compaction (if supported by your version)
# --geyser-plugin <remove for now to reduce memory>

# If you need to override ExecStart completely, create a separate override file with: 
# ExecStart=
# ExecStart=/usr/local/bin/solana-validator <FLAGS>

# Diagnostics: expose memory current value via cgroup path:
# cat /sys/fs/cgroup/system.slice/sol.service/memory.current

# OOM policy (log and restart instead of immediate kill cascade)
OOMPolicy=continue

# Security hardening (optional)
# NoNewPrivileges=true
# ProtectKernelTunables=true
# ProtectControlGroups=true
# ProtectHome=true
# PrivateTmp=true

# Notes:
# 1. MemoryMax prevents runaway RSS; tune after observing steady-state usage.
# 2. Lower accounts-index-memory-limit-mb if still OOM; 32G = 32768.
# 3. If ledger directory is huge, prune with --limit-ledger-size and use snapshots.
# 4. QUIC disable can reduce resource churn; test with/without.
# 5. If you see high swap usage (MemoryHigh hit frequently), set MemorySwapMax=0
#    and raise MemoryHigh slightly; also cap validator with:
#      --accounts-index-path /fastssd/accounts-index
#      --accounts-index-memory-limit-mb 32768
#      --accounts-db-cache-limit-mb 16384
