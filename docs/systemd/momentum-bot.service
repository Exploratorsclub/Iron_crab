[Unit]
Description=IronCrab Momentum Bot (Strategy)
After=network-online.target nats.service market-data.service
Wants=network-online.target
PartOf=ironcrab.target
# P1 Crash Isolation: NO hard dependencies - momentum-bot runs independently
# If market-data crashes, momentum-bot keeps running (no events = no intents).
# Crash here does NOT affect execution-engine which continues processing.

# Restart rate limiting (prevents crash loops from pegging CPU)
StartLimitBurst=10
StartLimitIntervalSec=300

[Service]
Type=notify
NotifyAccess=main
User=ironcrab
Group=ironcrab
WorkingDirectory=/home/ironcrab/Iron_crab

ExecStart=/home/ironcrab/Iron_crab/target/release/momentum-bot \
    --config /home/ironcrab/Iron_crab/my_config.server.toml \
    --nats-url nats://localhost:4222 \
    --metrics-port 9802

Environment=RUST_LOG=info,momentum_bot=info

# WICHTIG: Keine Wallet-Keys! momentum-bot exit(1) wenn Keys erkannt werden.
# Environment=KEYPAIR_PATH=  # NICHT SETZEN!

# P1 Crash Isolation: Watchdog for liveness detection
WatchdogSec=30
# Restart on failure
Restart=on-failure
RestartSec=3

# Resource controls
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
CPUWeight=100
CPUAffinity=56-59

# Hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ironcrab/Iron_crab/trade_logs

[Install]
WantedBy=ironcrab.target
