[Unit]
Description=IronCrab Trades History Server
After=network.target

[Service]
Type=simple
User=ironcrab
WorkingDirectory=/home/ironcrab/Iron_crab
Environment="IRONCRAB_TRADE_LOG_DIR=/home/ironcrab/Iron_crab/trade_logs"
ExecStart=/usr/bin/python3 /home/ironcrab/Iron_crab/scripts/trades_server.py --port 9899
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
