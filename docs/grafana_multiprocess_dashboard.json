{
  "title": "IronCrab Multi-Process Architecture",
  "description": "Dashboard for the Debuggable-First Multi-Process Architecture (market-data, momentum-bot, execution-engine)",
  "schemaVersion": 39,
  "version": 1,
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "5s",
  "tags": ["ironcrab", "multi-process", "trading"],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "Prometheus", "value": "Prometheus" }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "🔄 Pipeline Health",
      "gridPos": {"h":1,"w":24,"x":0,"y":0},
      "collapsed": false
    },
    {
      "type": "stat",
      "title": "market-data",
      "description": "Geyser event ingest service",
      "targets": [{ "expr": "up{job=\"market-data\"}", "refId": "A" }],
      "gridPos": {"h":3,"w":4,"x":0,"y":1},
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "1": { "text": "UP", "color": "green" } } },
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" } } }
          ]
        }
      }
    },
    {
      "type": "stat",
      "title": "momentum-bot",
      "description": "Strategy plane - 4-Filter policy",
      "targets": [{ "expr": "up{job=\"momentum-bot\"}", "refId": "A" }],
      "gridPos": {"h":3,"w":4,"x":4,"y":1},
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "1": { "text": "UP", "color": "green" } } },
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" } } }
          ]
        }
      }
    },
    {
      "type": "stat",
      "title": "execution-engine",
      "description": "Single-signer execution service",
      "targets": [{ "expr": "up{job=\"execution-engine\"}", "refId": "A" }],
      "gridPos": {"h":3,"w":4,"x":8,"y":1},
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "1": { "text": "UP", "color": "green" } } },
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" } } }
          ]
        }
      }
    },
    {
      "type": "stat",
      "title": "NATS Server",
      "description": "Message broker status",
      "targets": [{ "expr": "nats_server_info{server_id=~\".+\"} OR up{job=\"nats\"}", "refId": "A" }],
      "gridPos": {"h":3,"w":4,"x":12,"y":1},
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "1": { "text": "UP", "color": "green" } } },
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" } } }
          ]
        }
      }
    },
    {
      "type": "stat",
      "title": "Build Version",
      "targets": [{ "expr": "ironcrab_build_info", "refId": "A", "legendFormat": "{{version}}" }],
      "gridPos": {"h":3,"w":8,"x":16,"y":1},
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "blue" }
        }
      }
    },
    {
      "type": "row",
      "title": "📊 Market Data Service (Port 9801)",
      "gridPos": {"h":1,"w":24,"x":0,"y":4},
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "Events Received/sec",
      "description": "Geyser events per second",
      "targets": [{ "expr": "rate(market_events_received_total{job=\"market-data\"}[1m])", "refId": "A", "legendFormat": "events/s" }],
      "gridPos": {"h":6,"w":8,"x":0,"y":5},
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "ops"
        }
      }
    },
    {
      "type": "stat",
      "title": "Pools Tracked",
      "targets": [{ "expr": "pools_tracked_total{job=\"market-data\"}", "refId": "A" }],
      "gridPos": {"h":3,"w":4,"x":8,"y":5},
      "fieldConfig": {
        "defaults": { "color": { "mode": "fixed", "fixedColor": "purple" } }
      }
    },
    {
      "type": "stat",
      "title": "Tokens Tracked",
      "targets": [{ "expr": "tokens_tracked_total{job=\"market-data\"}", "refId": "A" }],
      "gridPos": {"h":3,"w":4,"x":12,"y":5},
      "fieldConfig": {
        "defaults": { "color": { "mode": "fixed", "fixedColor": "orange" } }
      }
    },
    {
      "type": "timeseries",
      "title": "Pool Discovery Rate",
      "targets": [{ "expr": "rate(pools_discovered_total{job=\"market-data\"}[5m])", "refId": "A", "legendFormat": "pools/min" }],
      "gridPos": {"h":6,"w":8,"x":16,"y":5},
      "fieldConfig": {
        "defaults": { "unit": "ops" }
      }
    },
    {
      "type": "stat",
      "title": "Raydium Pools",
      "targets": [{ "expr": "raydium_pools_total", "refId": "A" }],
      "gridPos": {"h":3,"w":4,"x":8,"y":8}
    },
    {
      "type": "stat",
      "title": "Orca Pools",
      "targets": [{ "expr": "orca_pools_total", "refId": "A" }],
      "gridPos": {"h":3,"w":4,"x":12,"y":8}
    },
    {
      "type": "row",
      "title": "🎯 Momentum Bot (Port 9802)",
      "gridPos": {"h":1,"w":24,"x":0,"y":11},
      "collapsed": false
    },
    {
      "type": "stat",
      "title": "Intents Generated",
      "description": "TradeIntents published to NATS",
      "targets": [{ "expr": "intents_generated_total{job=\"momentum-bot\"}", "refId": "A" }],
      "gridPos": {"h":4,"w":4,"x":0,"y":12},
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "yellow", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "4-Filter Passed",
      "targets": [{ "expr": "filter_passed_total{job=\"momentum-bot\"}", "refId": "A" }],
      "gridPos": {"h":4,"w":4,"x":4,"y":12},
      "fieldConfig": {
        "defaults": { "color": { "mode": "fixed", "fixedColor": "green" } }
      }
    },
    {
      "type": "stat",
      "title": "4-Filter Rejected",
      "targets": [{ "expr": "filter_rejected_total{job=\"momentum-bot\"}", "refId": "A" }],
      "gridPos": {"h":4,"w":4,"x":8,"y":12},
      "fieldConfig": {
        "defaults": { "color": { "mode": "fixed", "fixedColor": "red" } }
      }
    },
    {
      "type": "piechart",
      "title": "Filter Rejection Reasons",
      "targets": [
        { "expr": "filter_rejection_by_reason{job=\"momentum-bot\"}", "refId": "A", "legendFormat": "{{reason}}" }
      ],
      "gridPos": {"h":8,"w":8,"x":12,"y":12},
      "options": {
        "legend": { "displayMode": "table", "placement": "right" }
      }
    },
    {
      "type": "timeseries",
      "title": "Intent Generation Rate",
      "targets": [{ "expr": "rate(intents_generated_total{job=\"momentum-bot\"}[5m]) * 60", "refId": "A", "legendFormat": "intents/min" }],
      "gridPos": {"h":4,"w":12,"x":0,"y":16},
      "fieldConfig": {
        "defaults": { "unit": "short" }
      }
    },
    {
      "type": "row",
      "title": "⚡ Execution Engine (Port 9804)",
      "gridPos": {"h":1,"w":24,"x":0,"y":20},
      "collapsed": false
    },
    {
      "type": "stat",
      "title": "Intents Received",
      "targets": [{ "expr": "intents_received_total{job=\"execution-engine\"}", "refId": "A" }],
      "gridPos": {"h":4,"w":4,"x":0,"y":21},
      "fieldConfig": {
        "defaults": { "color": { "mode": "fixed", "fixedColor": "blue" } }
      }
    },
    {
      "type": "stat",
      "title": "Intents Executed",
      "targets": [{ "expr": "intents_executed_total{job=\"execution-engine\"}", "refId": "A" }],
      "gridPos": {"h":4,"w":4,"x":4,"y":21},
      "fieldConfig": {
        "defaults": { "color": { "mode": "fixed", "fixedColor": "green" } }
      }
    },
    {
      "type": "stat",
      "title": "Intents Rejected",
      "targets": [{ "expr": "intents_rejected_total{job=\"execution-engine\"}", "refId": "A" }],
      "gridPos": {"h":4,"w":4,"x":8,"y":21},
      "fieldConfig": {
        "defaults": { "color": { "mode": "fixed", "fixedColor": "orange" } }
      }
    },
    {
      "type": "stat",
      "title": "Simulation Failures",
      "targets": [{ "expr": "simulation_failures_total{job=\"execution-engine\"}", "refId": "A" }],
      "gridPos": {"h":4,"w":4,"x":12,"y":21},
      "fieldConfig": {
        "defaults": { "color": { "mode": "fixed", "fixedColor": "red" } }
      }
    },
    {
      "type": "stat",
      "title": "Available SOL",
      "targets": [{ "expr": "available_sol_lamports{job=\"execution-engine\"} / 1e9", "refId": "A" }],
      "gridPos": {"h":4,"w":4,"x":16,"y":21},
      "fieldConfig": {
        "defaults": { "unit": "short", "decimals": 2 }
      }
    },
    {
      "type": "stat",
      "title": "Active Locks",
      "targets": [{ "expr": "active_capital_locks{job=\"execution-engine\"}", "refId": "A" }],
      "gridPos": {"h":4,"w":4,"x":20,"y":21}
    },
    {
      "type": "timeseries",
      "title": "Execution Latency",
      "targets": [
        { "expr": "histogram_quantile(0.50, rate(execution_latency_ms_bucket{job=\"execution-engine\"}[5m]))", "refId": "A", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, rate(execution_latency_ms_bucket{job=\"execution-engine\"}[5m]))", "refId": "B", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, rate(execution_latency_ms_bucket{job=\"execution-engine\"}[5m]))", "refId": "C", "legendFormat": "p99" }
      ],
      "gridPos": {"h":6,"w":12,"x":0,"y":25},
      "fieldConfig": {
        "defaults": { "unit": "ms" }
      }
    },
    {
      "type": "piechart",
      "title": "Rejection Reasons",
      "targets": [
        { "expr": "intent_rejection_by_reason{job=\"execution-engine\"}", "refId": "A", "legendFormat": "{{reason}}" }
      ],
      "gridPos": {"h":6,"w":6,"x":12,"y":25},
      "options": {
        "legend": { "displayMode": "table", "placement": "right" }
      }
    },
    {
      "type": "timeseries",
      "title": "Open Positions",
      "targets": [{ "expr": "open_positions{job=\"execution-engine\"}", "refId": "A" }],
      "gridPos": {"h":6,"w":6,"x":18,"y":25}
    },
    {
      "type": "row",
      "title": "💰 PnL & Performance",
      "gridPos": {"h":1,"w":24,"x":0,"y":31},
      "collapsed": false
    },
    {
      "type": "stat",
      "title": "Daily PnL (SOL)",
      "targets": [{ "expr": "daily_realized_pnl_sol", "refId": "A" }],
      "gridPos": {"h":4,"w":6,"x":0,"y":32},
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 4,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0 },
              { "color": "green", "value": 0.01 }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Trades Executed",
      "targets": [{ "expr": "trades_executed_total", "refId": "A" }],
      "gridPos": {"h":4,"w":4,"x":6,"y":32}
    },
    {
      "type": "stat",
      "title": "Trades Failed",
      "targets": [{ "expr": "trades_failed_total", "refId": "A" }],
      "gridPos": {"h":4,"w":4,"x":10,"y":32},
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Sharpe Ratio",
      "targets": [{ "expr": "ironcrab_sharpe_ratio", "refId": "A" }],
      "gridPos": {"h":4,"w":5,"x":14,"y":32},
      "fieldConfig": {
        "defaults": { "decimals": 2 }
      }
    },
    {
      "type": "stat",
      "title": "Max Drawdown %",
      "targets": [{ "expr": "ironcrab_drawdown_pct", "refId": "A" }],
      "gridPos": {"h":4,"w":5,"x":19,"y":32},
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 10 }
            ]
          }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "PnL Over Time",
      "targets": [{ "expr": "daily_realized_pnl_sol", "refId": "A", "legendFormat": "PnL (SOL)" }],
      "gridPos": {"h":6,"w":24,"x":0,"y":36},
      "fieldConfig": {
        "defaults": { "unit": "short", "decimals": 4 }
      }
    },
    {
      "type": "row",
      "title": "🔗 NATS Message Flow",
      "gridPos": {"h":1,"w":24,"x":0,"y":42},
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "NATS Message Rates",
      "targets": [
        { "expr": "rate(nats_messages_published_total{topic=\"market_events\"}[1m])", "refId": "A", "legendFormat": "MarketEvents pub" },
        { "expr": "rate(nats_messages_published_total{topic=\"trade_intents\"}[1m])", "refId": "B", "legendFormat": "TradeIntents pub" },
        { "expr": "rate(nats_messages_received_total{topic=\"trade_intents\"}[1m])", "refId": "C", "legendFormat": "TradeIntents recv" },
        { "expr": "rate(nats_messages_published_total{topic=\"execution_results\"}[1m])", "refId": "D", "legendFormat": "ExecutionResults" }
      ],
      "gridPos": {"h":6,"w":12,"x":0,"y":43},
      "fieldConfig": {
        "defaults": { "unit": "ops" }
      }
    },
    {
      "type": "stat",
      "title": "NATS Reconnects",
      "targets": [{ "expr": "nats_reconnects_total", "refId": "A" }],
      "gridPos": {"h":3,"w":4,"x":12,"y":43},
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "NATS Errors",
      "targets": [{ "expr": "nats_errors_total", "refId": "A" }],
      "gridPos": {"h":3,"w":4,"x":16,"y":43},
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      }
    }
  ]
}
