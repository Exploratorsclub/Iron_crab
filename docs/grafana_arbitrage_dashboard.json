{
  "title": "IronCrab Arbitrage Engine",
  "schemaVersion": 39,
  "version": 2,
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    { "type": "stat", "title": "Total Opportunities Detected", "targets": [{ "expr": "arb_triangle_opportunities_total", "refId": "A" }], "gridPos": {"h":6,"w":6,"x":0,"y":0} },
    { "type": "stat", "title": "Attempts (Total)", "targets": [{ "expr": "arb_triangle_attempts_total", "refId": "A" }], "gridPos": {"h":6,"w":6,"x":6,"y":0} },
    { "type": "stat", "title": "Profitable Executions", "targets": [{ "expr": "arb_triangle_profitable_total", "refId": "A" }], "gridPos": {"h":6,"w":6,"x":12,"y":0} },
    { "type": "stat", "title": "Success Rate %", "targets": [{ "expr": "(arb_triangle_profitable_total / (arb_triangle_attempts_total + 1)) * 100", "refId": "A" }], "gridPos": {"h":6,"w":6,"x":18,"y":0} },

    { "type": "timeseries", "title": "Opportunities Rate (per minute)", "targets": [
        { "expr": "rate(arb_triangle_opportunities_total[1m]) * 60", "legendFormat": "Opportunities/min", "refId": "A" }
      ], "gridPos": {"h":8,"w":12,"x":0,"y":6} },
    { "type": "timeseries", "title": "Attempts vs Profitable (rate)", "targets": [
        { "expr": "rate(arb_triangle_attempts_total[5m])", "legendFormat": "Attempts" },
        { "expr": "rate(arb_triangle_profitable_total[5m])", "legendFormat": "Profitable" }
      ], "gridPos": {"h":8,"w":12,"x":12,"y":6} },

    { "type": "timeseries", "title": "Cumulative Opportunities Found", "targets": [
        { "expr": "increase(arb_triangle_opportunities_total[5m])", "legendFormat": "Opportunities (5min windows)", "refId": "A" }
      ], "gridPos": {"h":7,"w":24,"x":0,"y":14} },

    { "type": "timeseries", "title": "Detection Rate Trend (1min avg)", "targets": [
        { "expr": "rate(arb_triangle_opportunities_total[1m]) * 60", "legendFormat": "Current rate", "refId": "A" }
      ], "gridPos": {"h":7,"w":12,"x":0,"y":21} },
    { "type": "timeseries", "title": "Success % Trend", "targets": [
        { "expr": "(rate(arb_triangle_profitable_total[5m]) / (rate(arb_triangle_attempts_total[5m]) + 0.0001)) * 100", "legendFormat": "Success %", "refId": "A" }
      ], "gridPos": {"h":7,"w":12,"x":12,"y":21} }
  ],
  "templating": { "list": [] }
}
